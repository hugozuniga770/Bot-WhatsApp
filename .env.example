# Copia este archivo como .env y llena los valores. El .env NUNCA se sube a GitHub (.gitignore).
# En Render estas mismas variables están en el panel del servicio (Environment).
#
# Desde la v2.0 las llaves de cada empresa (Claude, Meta) NO van aquí:
# se cargan desde el panel o desde el enlace de alta y se guardan cifradas en la base.

# --- Obligatorias ---
# Contraseña para entrar al panel (/panel). Mínimo 10 caracteres.
ADMIN_PASSWORD=
# Clave con la que se cifran las llaves de las empresas. Mínimo 16 caracteres.
# En PowerShell puedes generar una con:  [guid]::NewGuid().ToString("N") + [guid]::NewGuid().ToString("N")
# OJO: si cambia, las llaves guardadas ya no se pueden leer. En Render se genera sola: cópiala a un lugar seguro.
CLAVE_MAESTRA=

# --- Recomendada ---
# Cadena de conexión de PostgreSQL (Neon -> Connect). Vacía = todo en memoria (solo para probar en tu PC).
DATABASE_URL=

# --- Opcionales (estos son los valores por defecto) ---
# Dirección pública del servicio. En Render se toma sola de RENDER_EXTERNAL_URL.
URL_PUBLICA=
# Zona horaria para contar el uso por día.
ZONA_HORARIA=America/La_Paz
# Versión de la API de Meta: usa la que aparece en los ejemplos del panel de Meta.
GRAPH_VERSION=v23.0
PORT=5000
