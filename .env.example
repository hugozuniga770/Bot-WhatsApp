# Copia este archivo como .env y llena los valores. El .env NUNCA se sube a GitHub (.gitignore).
# En Render estas mismas variables se cargan en el panel del servicio (Environment).

# --- Obligatorias ---
# Llave de la API de Claude: platform.claude.com -> Settings -> API keys
ANTHROPIC_API_KEY=
# Meta (developers.facebook.com -> tu app -> WhatsApp -> API Setup)
WHATSAPP_TOKEN=
PHONE_NUMBER_ID=
# Meta: App settings -> Basic -> App secret. Sirve para comprobar que los avisos vienen de Meta.
APP_SECRET=
# Palabra secreta que inventas tú. La misma va en Meta al configurar el webhook.
VERIFY_TOKEN=

# --- Opcionales (estos son los valores por defecto) ---
# Cadena de conexión de MongoDB Atlas. Vacía = todo en memoria (solo para probar en tu PC).
MONGODB_URI=
MONGODB_BASE=bot_whatsapp
# Número que recibe el aviso cuando el bot pasa un chat a la dueña (con código de país, sin +).
DUENA_NUMERO=
# Horas que el bot deja de responder en un chat derivado.
PAUSA_HORAS=12
# Mensajes de la conversación que recibe Claude en cada respuesta.
HISTORY_LIMIT=20
MAX_TOKENS=600
CLAUDE_MODEL=claude-haiku-5-5
# Usa la versión que aparece en los ejemplos del panel de Meta.
GRAPH_VERSION=v23.0
PORT=5000
